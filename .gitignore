# Secrets — never commit real credentials
.env
.env.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Node / frontend
node_modules/
dist/
build/

# Local databases
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# Uploaded user files and local vector index (regenerated at runtime)
data/uploads/*
data/vector_store/*
!data/uploads/.gitkeep
!data/vector_store/.gitkeep

# OS / editors
.DS_Store
.idea/
.vscode/
