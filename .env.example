# DocuMind AI — environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.

# SQLite for local dev (default when unset: <project-root>/data/documind.db).
# Use a postgres URL in production, e.g.
# postgresql+psycopg2://user:password@localhost:5432/documind
#DATABASE_URL=sqlite:///./data/documind.db

# Local directories (created automatically if missing).
# Defaults when unset: <project-root>/data/vector_store and <project-root>/data/uploads
#VECTOR_STORE_DIR=./data/vector_store
#UPLOAD_DIR=./data/uploads

# Upload / RAG tuning
MAX_UPLOAD_MB=20
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.30

# true  -> local deterministic mock embeddings + extractive mock LLM
#          (local-testing baseline, NOT production quality)
# false -> use the OpenAI-compatible APIs below
MOCK_MODE=true

# OpenAI-compatible embedding API (used when MOCK_MODE=false)
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# OpenAI-compatible chat completion API (used when MOCK_MODE=false)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# HTTP timeout (seconds) for embedding/LLM calls
HTTP_TIMEOUT_S=30

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# development | production
APP_ENV=development
